    <div><span class="lbl">联络号码</span><input class="inp" id="wf_ph" value="${w?.phone||''}" type="tel" placeholder="0126741188"></div>
    <div><span class="lbl">护照号码</span><input class="inp" id="wf_pp" value="${w?.passportNo||''}" placeholder="A25649873"></div>
    <div class="row">
      <div class="fc"><span class="lbl">护照逾期</span><input class="inp" id="wf_ppe" type="date" value="${gd('Pasport').expiry||''}"></div>
      <div class="fc"><span class="lbl">准证逾期</span><input class="inp" id="wf_pe" type="date" value="${gd('Permit').expiry||''}"></div>
    </div>
    <div class="row">
      <div class="fc"><span class="lbl">FOMEMA 逾期</span><input class="inp" id="wf_fe" type="date" value="${gd('FOMEMA').expiry||''}"></div>
      <div class="fc"><span class="lbl">Insurance 逾期</span><input class="inp" id="wf_ie" type="date" value="${gd('Insurance').expiry||''}"></div>
    </div>
    <div class="row">
      <div class="fc"><span class="lbl">地点</span><input class="inp" id="wf_loc" value="${w?.location||''}" placeholder="Bertam"></div>
      <div class="fc"><span class="lbl">类别</span>
        <select class="inp" id="wf_sec">
          <option value="AGRO" ${w?.sector==='AGRO'?'selected':''}>AGRO</option>
          <option value="Other" ${w?.sector==='Other'?'selected':''}>Other</option>
          <option value="Construction" ${w?.sector==='Construction'?'selected':''}>Construction</option>
          <option value="Manufacturing" ${w?.sector==='Manufacturing'?'selected':''}>Manufacturing</option>
        </select>
      </div>
    </div>
    <div><span class="lbl">曾经项目（逗号分隔）</span><input class="inp" id="wf_proj" value="${(w?.projects||[]).join(', ')}" placeholder="FOMEMA SETTING, CIDB"></div>
    <div><span class="lbl">备注</span><input class="inp" id="wf_notes" value="${w?.notes||''}"></div>
    <div class="mbtns">
      <button class="mbtn" onclick="cM()">取消</button>
      <button class="mbtn pri" onclick="saveW(${id||'null'})">✅ 保存</button>
    </div>`;
  oM();
}

function saveW(id){
  const name=document.getElementById('wf_n').value.trim();
  if(!name){ alert('请输入姓名'); return; }
  const ppe=document.getElementById('wf_ppe').value;
  const pe=document.getElementById('wf_pe').value;
  const fe=document.getElementById('wf_fe').value;
  const ie=document.getElementById('wf_ie').value;
  const proj=document.getElementById('wf_proj').value;
  const data={
    name, ini:name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase(),
    blood:document.getElementById('wf_b').value.trim(),
    phone:document.getElementById('wf_ph').value.trim(),
    passportNo:document.getElementById('wf_pp').value.trim(),
    nationality:document.getElementById('wf_nat').value.trim(),
    location:document.getElementById('wf_loc').value.trim(),
    sector:document.getElementById('wf_sec').value,
    notes:document.getElementById('wf_notes').value.trim(),
    projects:proj?proj.split(',').map(x=>x.trim()).filter(Boolean):[],
    status:'active',
    docs:[
      {name:'Pasport',  icon:'🛂', expiry:ppe},
      {name:'Permit',   icon:'📄', expiry:pe},
      {name:'FOMEMA',   icon:'🏥', expiry:fe},
      {name:'Insurance',icon:'🛡️', expiry:ie},
    ],
  };
  if(id){ const i=S.workers.findIndex(x=>x.id===id); if(i>=0){ data.id=id; data.invoices=S.workers[i].invoices||[]; data.joinDate=S.workers[i].joinDate; S.workers[i]=data; } }
  else { data.id=S.nextId++; data.joinDate=today(); data.invoices=[]; S.workers.push(data); }
  sv(); cM(); renderW(); updPill();
}

// ═══════════ ALERTS ═══════════
function renderAlerts(){
  const items=[];
  S.workers.forEach(w=>{
    // Debt alerts
    const {balance}=invTotals(w);
    if(balance>0){
      const oldest=(w.invoices||[]).filter(inv=>{ const pd=(inv.payments||[]).reduce((s,p)=>s+p.amount,0); return pd<inv.amount; }).sort((a,b)=>a.date.localeCompare(b.date))[0];
      items.push({type:'debt',w,balance,oldest});
    }
    // Doc alerts
    w.docs.forEach(d=>{
      const ds=docSt(d.expiry);
      const days=daysUntil(d.expiry);
      if(ds==='exp'||ds==='warn') items.push({type:ds,w,doc:d,days});
    });
  });
  items.sort((a,b)=>{
    const rank={exp:0,debt:1,warn:2};
    return (rank[a.type]||3)-(rank[b.type]||3);
  });
  const c=document.getElementById('alertList');
  if(!items.length){ c.innerHTML='<div style="text-align:center;padding:40px;color:var(--tx2);font-size:13px">✅ 暂无需处理事项</div>'; return; }
  c.innerHTML=items.map(it=>{
    const tel=(it.w.phone||'').replace(/[^0-9]/g,'');
    if(it.type==='debt'){
      return `<div class="ac debt">
        <div class="ac-ico">💸</div>
        <div style="flex:1">
          <div class="ac-title">${it.w.name} — 欠款未结清</div>
          <div class="ac-desc">共欠 <strong style="color:var(--rd)">${fmt(it.balance)}</strong>${it.oldest?` · 最早账单：${it.oldest.service} (${it.oldest.date})`:''}
          </div>
          <div style="display:flex;gap:6px;margin-top:7px">
            <a class="wact wa-wa" href="https://wa.me/6${tel}" target="_blank" style="padding:5px 12px;font-size:11px">💬 催款</a>
            <button class="wact wa-inv" onclick="goTab(1)" style="padding:5px 12px;font-size:11px;background:rgba(245,166,35,.15);color:var(--or);border:1px solid var(--bo)">查看账单</button>
          </div>
        </div>
      </div>`;
    }
    let feeNote='';
    if(it.doc.name==='Permit'&&it.type==='exp'){
      const d=Math.abs(it.days);
      if(d<=3) feeNote='💸 ESP: RM150';
      else if(d<=90) feeNote=`💸 ESP: RM${(d*50).toLocaleString()} (${d}天×RM50)`;
      else feeNote='💸 ESP: RM3,100 + RM1,500';
    }
    if(it.doc.name==='Permit'&&it.type==='warn'&&it.days<=3) feeNote='💸 即将触发 ESP RM150';
    return `<div class="ac ${it.type==='exp'?'':'warn'}">
      <div class="ac-ico">${it.type==='exp'?'🚨':'⏰'}</div>
      <div style="flex:1">
        <div class="ac-title">${it.w.name} — ${it.doc.name}</div>
        <div class="ac-desc">${it.type==='exp'?`已过期 ${Math.abs(it.days)} 天`:`还有 ${it.days} 天到期`} · ${it.doc.expiry}</div>
        ${feeNote?`<div class="ac-fee">${feeNote}</div>`:''}
        <div style="display:flex;gap:6px;margin-top:7px">
          <a class="wact wa-wa" href="https://wa.me/6${tel}" target="_blank" style="padding:5px 12px;font-size:11px">💬 联系</a>
        </div>
      </div>
    </div>`;
  }).join('');
}

// ═══════════ STATS ═══════════
function renderStats(){
  let totalBilled=0,totalPaid=0;
  S.workers.forEach(w=>{ const t=invTotals(w); totalBilled+=t.billed; totalPaid+=t.paid; });
  document.getElementById('stW').textContent=S.workers.length;
  document.getElementById('stR').textContent=fmt(totalBilled);
  document.getElementById('stP').textContent=fmt(totalPaid);
  document.getElementById('stD').textContent=fmt(totalBilled-totalPaid);

  // Debt list
  const debtors=S.workers.map(w=>({w,b:invTotals(w).balance})).filter(x=>x.b>0).sort((a,b)=>b.b-a.b);
  document.getElementById('debtList').innerHTML=debtors.length?
    debtors.map(({w,b})=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--bo2)">
      <div><div style="font-size:12px;font-weight:600">${w.name}</div><div style="font-size:10px;color:var(--tx2)">${w.phone||'-'}</div></div>
      <span style="font-size:13px;font-weight:700;color:var(--rd)">${fmt(b)}</span>
    </div>`).join('') :
    '<div style="font-size:12px;color:var(--tx2);text-align:center;padding:10px">✅ 无欠款</div>';

  // Upcoming docs 90 days
  const upcom=[];
  S.workers.forEach(w=>{ w.docs.forEach(d=>{ const days=daysUntil(d.expiry); if(days!==null&&days>=0&&days<=90) upcom.push({name:w.name,doc:d.name,days,exp:d.expiry}); }); });
  upcom.sort((a,b)=>a.days-b.days);
  document.getElementById('docExp').innerHTML=upcom.length?
    upcom.map(u=>`<div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--bo2)">
      <div><div style="font-size:12px;font-weight:600">${u.name}</div><div style="font-size:10px;color:var(--tx2)">${u.doc} · ${u.exp}</div></div>
      <span class="bd ${u.days<30?'b-exp':'b-warn'}">${u.days}天后</span>
    </div>`).join('') :
    '<div style="font-size:12px;color:var(--tx2);text-align:center;padding:10px">✅ 90天内无文件到期</div>';
}

// ═══════════ PERMIT CALC ═══════════
function setPT(t){
  document.getElementById('ca').classList.toggle('on',t==='AGRO');
  document.getElementById('co').classList.toggle('on',t==='OTHER');
  const levy=t==='AGRO'?845:1850;
  const sub=levy+205+203.5+250+350;
  const sst=sub*0.06;
  document.getElementById('pL').textContent=`RM ${levy.toFixed(2)}`;
  document.getElementById('pS').textContent=`RM ${sub.toFixed(2)}`;
  document.getElementById('pST').textContent=`RM ${sst.toFixed(2)}`;
  document.getElementById('pT').textContent=`RM ${(sub+sst).toFixed(2)}`;
}

// ═══════════ CHAT ═══════════
let pendingCat=null;
function initChat(){
  document.getElementById('cw').innerHTML='';
  botMsg(`嗨！帮你记录收款 😊\n\n💰「收 Ahmad FOMEMA 1500 现金」\n💰「收 Ramu 准证 2000 转账」\n💰「收 Mohamed 现金 300」\n✏️「改」修改上一条\n🗑️「删除」删除上一条`);
}
function botMsg(txt,chips){
  const cw=document.getElementById('cw');
  const d=document.createElement('div'); d.className='msg bot';
  d.innerHTML=`<div>${txt.replace(/\n/g,'<br>')}</div><div class="msg-t">${now12()}</div>`;
  if(chips?.length){ const ch=document.createElement('div'); ch.className='chips'; chips.forEach(c=>{ const b=document.createElement('button'); b.className='chip'; b.textContent=c; b.onclick=()=>pickCat(c); ch.appendChild(b); }); d.appendChild(ch); }
  cw.appendChild(d); scrollC();
}
function userMsg(txt){ const cw=document.getElementById('cw'); const d=document.createElement('div'); d.className='msg user'; d.innerHTML=`<div>${txt}</div><div class="msg-t">${now12()}</div>`; cw.appendChild(d); scrollC(); }
function showTyp(){ const cw=document.getElementById('cw'); const d=document.createElement('div'); d.className='msg bot'; d.id='typ'; d.innerHTML='<div class="typing"><span></span><span></span><span></span></div>'; cw.appendChild(d); scrollC(); }
function hideTyp(){ document.getElementById('typ')?.remove(); }
function scrollC(){ setTimeout(()=>{ document.getElementById('area').scrollTop=99999; },40); }

async function send(){
  const inp=document.getElementById('cin'); const txt=inp.value.trim(); if(!txt) return;
  inp.value=''; userMsg(txt);
  const l=txt.toLowerCase();
  if(l==='删除') { delLastTxn(); return; }
  if(l==='改') { editLastTxn(); return; }
  showTyp();
  try{ const r=await aiClass(txt); hideTyp(); handleAI(r,txt); }
  catch(e){ hideTyp(); handleAI(simpleClass(txt),txt); }
}

async function aiClass(txt){
  const wnames=S.workers.map(w=>w.name).join(', ');
  const resp=await fetch('https://api.anthropic.com/v1/messages',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:300,
      messages:[{role:'user',content:`你是外劳人力资源公司收款记录助手。
外劳名单: ${wnames}
用户输入: "${txt}"
分析返回JSON（只JSON）:
{"wname":"外劳姓名或空","service":"服务项目","amount":数字,"method":"现金"|"TNG"|"转账"|"扣薪","confident":true|false}
服务参考: FOMEMA,准证更新,ESP逾期,CIDB,文件费,Insurance,保险,部门文件,亲属文件,家属证,KWSP,其他`}]})});
  const data=await resp.json();
  return JSON.parse(data.content.map(c=>c.text||'').join('').replace(/```json|```/g,'').trim());
}
function simpleClass(txt){
  const nums=txt.match(/[\d,]+\.?\d*/g);
  const amount=nums?parseFloat(nums[nums.length-1].replace(',','')):0;
  const methods=['现金','tng','转账','扣薪'];
  const method=methods.find(m=>txt.toLowerCase().includes(m))||'现金';
  return {wname:'',service:'其他',amount,method,confident:false};
}
function handleAI(r,raw){
  if(!r.amount){ botMsg('🤔 没找到金额，请重试，例如："收 Ahmad FOMEMA 1500 现金"'); return; }
  if(!r.confident||!r.wname){
    pendingCat={...r,raw};
    const chips=['现金','TNG','转账','扣薪'];
    if(!r.wname){
      const wchips=S.workers.map(w=>w.name);
      botMsg(`收款 RM${r.amount.toFixed(2)} · ${r.service}\n这是哪位外劳的付款？`,wchips);
    } else {
      botMsg(`🤔「${r.wname}」${r.service} RM${r.amount.toFixed(2)}\n付款方式？`,chips);
    }
  } else {
    logTxn(r); botMsg(`✅ 已记录 ${r.wname} · ${r.service} · ${fmt(r.amount)} · ${r.method}`);
  }
}
function pickCat(val){
  document.querySelectorAll('.chips').forEach(c=>c.remove());
  if(!pendingCat) return;
  const isWorker=S.workers.some(w=>w.name===val);
  if(!pendingCat.wname&&isWorker){ pendingCat.wname=val; botMsg(`付款方式？`,['现金','TNG','转账','扣薪']); return; }
  if(['现金','TNG','转账','扣薪'].includes(val)){ pendingCat.method=val; }
  logTxn(pendingCat);
  botMsg(`✅ 已记录 ${pendingCat.wname||'?'} · ${pendingCat.service} · ${fmt(pendingCat.amount)} · ${pendingCat.method}`);
  pendingCat=null;
}
function logTxn(r){
  S.txns.push({id:S.nextId++,date:today(),wname:r.wname,service:r.service,amount:r.amount,method:r.method});
  sv();
}
function delLastTxn(){ if(!S.txns.length){botMsg('没有记录~');return;} const l=S.txns.pop(); sv(); botMsg(`🗑️ 已删除：${l.wname} ${l.service} ${fmt(l.amount)}`); }
function editLastTxn(){ botMsg('✏️ 请重新输入，我会替换上一条：'); if(S.txns.length) S.txns.pop(); sv(); }

// ═══════════ MODAL ═══════════
function oM(){ document.getElementById('mo').classList.add('open'); }
function cM(){ document.getElementById('mo').classList.remove('open'); }
function cMOut(e){ if(e.target===document.getElementById('mo')) cM(); }

// ═══════════ INIT ═══════════
window.addEventListener('DOMContentLoaded',()=>{
  if(!S.workers) S.workers=[];
  if(!S.txns) S.txns=[];
  S.workers.forEach(w=>{ if(!w.invoices) w.invoices=[]; });
  initChat(); updPill();
});
</script>
