function savePay(wid,invId){
  const amt=parseFloat(document.getElementById('pay_amt').value)||0;
  const method=document.getElementById('pay_m').value;
  if(!amt){ alert('请填写金额'); return; }
  const w=S.workers.find(x=>x.id===wid);
