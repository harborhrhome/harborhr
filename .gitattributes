  if(!inv) return;
  if(!inv.payments) inv.payments=[];
  inv.payments.push({id:S.nextId++,amount:amt,date:today(),method});
  S.txns.push({id:S.nextId++,date:today(),wid,wname:w.name,type:'payment',method,amount:amt});
  sv(); cM(); renderW(); updPill();
}

function delInv(wid,invId){
  if(!confirm('删除此账单？')) return;
  const w=S.workers.find(x=>x.id===wid);
  if(w) w.invoices=(w.invoices||[]).filter(x=>x.id!==invId);
  sv(); renderW(); updPill();
}

