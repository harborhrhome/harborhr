<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0e1117">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="HR Home">
<title>🏢 HR Home</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0e1117;--bg2:#161b27;--bg3:#1c2333;
  --or:#f5a623;--or2:#ffc04d;
  --gr:#22c55e;--rd:#ef4444;--bl:#3b82f6;--pu:#a855f7;--cy:#06b6d4;
  --tx:#e8eaf0;--tx2:#8b95a8;
  --bo:rgba(245,166,35,.18);--bo2:rgba(255,255,255,.07);
  --r:13px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;overflow:hidden;}
body{font-family:'Noto Sans SC',sans-serif;background:var(--bg);color:var(--tx);display:flex;flex-direction:column;height:100dvh;}

/* HDR */
.hdr{background:var(--bg2);border-bottom:1px solid var(--bo2);padding:10px 15px 9px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.hdr-l{display:flex;align-items:center;gap:9px;}
.hdr-ico{width:33px;height:33px;background:linear-gradient(135deg,var(--or),var(--or2));border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;}
.hdr-name{font-size:14px;font-weight:700;}
.hdr-sub{font-size:9px;color:var(--or);letter-spacing:1.5px;text-transform:uppercase;display:block;}
.hdr-pill{background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);color:var(--rd);font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;cursor:pointer;display:none;}

/* TABS */
.tabs{background:var(--bg2);border-bottom:1px solid var(--bo2);display:flex;flex-shrink:0;}
.tab{flex:1;background:none;border:none;border-bottom:2px solid transparent;color:var(--tx2);font-family:'Noto Sans SC',sans-serif;font-size:10px;font-weight:500;padding:7px 2px 8px;cursor:pointer;transition:all .2s;}
.tab.on{color:var(--or);border-bottom-color:var(--or);}

/* AREA */
.area{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;}
.pg{display:none;padding-bottom:80px;}
.pg.on{display:block;}

/* GENERIC */
.card{background:var(--bg2);border:1px solid var(--bo2);border-radius:var(--r);margin:10px 13px 0;}
.ci{padding:13px 14px;}
.sh{display:flex;align-items:center;justify-content:space-between;padding:14px 13px 7px;}
.st{font-size:11px;font-weight:700;color:var(--tx2);letter-spacing:1.2px;text-transform:uppercase;}
.inp{background:var(--bg3);border:1px solid var(--bo2);border-radius:10px;padding:9px 12px;color:var(--tx);font-family:'Noto Sans SC',sans-serif;font-size:13px;outline:none;width:100%;}
.inp:focus{border-color:var(--or);}
.lbl{font-size:10px;color:var(--tx2);margin-bottom:4px;display:block;}
.row{display:flex;gap:8px;}
.row .fc{flex:1;}
.btn{border:none;border-radius:10px;padding:11px;font-family:'Noto Sans SC',sans-serif;font-size:13px;font-weight:600;cursor:pointer;width:100%;display:block;transition:all .15s;}
.btn-or{background:var(--or);color:#1a0e00;}
.btn-ghost{background:var(--bg3);border:1px solid var(--bo2);color:var(--tx2);}
.btn-rd{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);color:var(--rd);}
.btn:active{transform:scale(.97);}

/* BADGE */
.bd{display:inline-block;font-size:10px;font-weight:700;padding:2px 8px;border-radius:12px;}
.b-ok{background:rgba(34,197,94,.15);color:var(--gr);border:1px solid rgba(34,197,94,.25);}
.b-warn{background:rgba(245,166,35,.15);color:var(--or);border:1px solid var(--bo);}
.b-exp{background:rgba(239,68,68,.15);color:var(--rd);border:1px solid rgba(239,68,68,.25);}
.b-bl{background:rgba(59,130,246,.15);color:var(--bl);border:1px solid rgba(59,130,246,.25);}
.b-pu{background:rgba(168,85,247,.15);color:var(--pu);border:1px solid rgba(168,85,247,.25);}
.b-gr{background:rgba(139,149,168,.12);color:var(--tx2);border:1px solid var(--bo2);}
.b-cy{background:rgba(6,182,212,.15);color:var(--cy);border:1px solid rgba(6,182,212,.25);}

/* SEARCH */
.sbar{margin:10px 13px 7px;background:var(--bg3);border:1px solid var(--bo2);border-radius:22px;padding:9px 14px;display:flex;align-items:center;gap:7px;}
.sbar input{flex:1;background:none;border:none;color:var(--tx);font-family:'Noto Sans SC',sans-serif;font-size:13px;outline:none;}
.sbar input::placeholder{color:var(--tx2);}

/* FILTER */
.ftabs{display:flex;gap:5px;padding:0 13px 8px;flex-wrap:wrap;}
.ftab{background:var(--bg2);border:1px solid var(--bo2);color:var(--tx2);font-family:'Noto Sans SC',sans-serif;font-size:10px;padding:4px 11px;border-radius:20px;cursor:pointer;transition:all .15s;}
.ftab.on{background:var(--or);color:#1a0e00;border-color:var(--or);font-weight:700;}

/* WORKER CARD */
.wc{background:var(--bg2);border:1px solid var(--bo2);border-radius:var(--r);margin:0 13px 9px;overflow:hidden;transition:border-color .2s;}
.wc.ok{border-color:rgba(34,197,94,.25);}
.wc.warn{border-color:rgba(245,166,35,.35);}
.wc.exp{border-color:rgba(239,68,68,.4);}
.wc.debt{border-color:rgba(239,68,68,.5);}
.wh{display:flex;align-items:center;gap:10px;padding:11px 13px;cursor:pointer;}
.wa{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--or),#b37410);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#1a0e00;flex-shrink:0;}
.wi{flex:1;min-width:0;}
.wn{font-size:13px;font-weight:700;}
.wm{font-size:10px;color:var(--tx2);margin-top:2px;}
.wb{display:none;border-top:1px solid var(--bo2);}
.wb.open{display:block;}

/* BILLING SUMMARY BAR */
.bill-bar{display:flex;align-items:center;justify-content:space-between;padding:10px 13px;background:var(--bg3);border-bottom:1px solid var(--bo2);}
.bill-bar-item{text-align:center;}
.bill-bar-label{font-size:9px;color:var(--tx2);letter-spacing:.5px;text-transform:uppercase;}
.bill-bar-val{font-size:14px;font-weight:700;margin-top:2px;}

/* INVOICE LIST */
.inv-wrap{padding:10px 13px;}
.inv-item{background:var(--bg3);border:1px solid var(--bo2);border-radius:10px;padding:10px 12px;margin-bottom:7px;display:flex;align-items:flex-start;justify-content:space-between;gap:8px;}
.inv-item.paid{opacity:.65;}
.inv-left{flex:1;min-width:0;}
.inv-name{font-size:12px;font-weight:600;}
.inv-date{font-size:10px;color:var(--tx2);margin-top:2px;}
.inv-note{font-size:10px;color:var(--tx2);margin-top:2px;}
.inv-right{text-align:right;flex-shrink:0;}
.inv-amt{font-size:14px;font-weight:700;color:var(--or);}
.inv-paid{font-size:10px;color:var(--gr);margin-top:2px;}
.inv-bal{font-size:10px;color:var(--rd);margin-top:1px;font-weight:600;}
.inv-actions{display:flex;gap:5px;margin-top:5px;justify-content:flex-end;}
.ia{background:none;border:none;font-size:12px;cursor:pointer;padding:2px 4px;border-radius:5px;}
.ia.pay{background:rgba(34,197,94,.12);color:var(--gr);font-size:11px;padding:3px 9px;border-radius:8px;font-family:'Noto Sans SC',sans-serif;font-weight:600;}
.ia.del{color:var(--rd);}

/* PAYMENT LIST */
.pay-item{background:var(--bg3);border:1px solid rgba(34,197,94,.2);border-radius:10px;padding:9px 12px;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between;}
.pay-left{display:flex;align-items:center;gap:8px;}
.pay-ico{font-size:18px;}
.pay-label{font-size:12px;font-weight:600;color:var(--gr);}
.pay-meta{font-size:10px;color:var(--tx2);margin-top:1px;}
.pay-amt{font-size:14px;font-weight:700;color:var(--gr);}

/* ADD INVOICE FORM */
.fee-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:10px;}
.fee-btn{background:var(--bg3);border:1px solid var(--bo2);border-radius:10px;padding:10px 8px;text-align:center;cursor:pointer;transition:all .15s;font-family:'Noto Sans SC',sans-serif;}
.fee-btn.sel{background:rgba(245,166,35,.15);border-color:var(--or);}
.fee-btn:active{transform:scale(.96);}
.fee-btn-name{font-size:11px;font-weight:600;color:var(--tx);}
.fee-btn-price{font-size:12px;font-weight:700;color:var(--or);margin-top:2px;}

/* W ACTIONS */
.wacts{display:flex;gap:6px;padding:10px 13px;}
.wact{flex:1;padding:8px 4px;border-radius:9px;text-align:center;text-decoration:none;font-family:'Noto Sans SC',sans-serif;font-size:11px;font-weight:600;cursor:pointer;border:none;display:block;transition:all .15s;}
.wa-call{background:rgba(34,197,94,.12);color:var(--gr);border:1px solid rgba(34,197,94,.25);}
.wa-wa{background:rgba(37,211,102,.12);color:#25d366;border:1px solid rgba(37,211,102,.25);}
.wa-inv{background:var(--or);color:#1a0e00;}
.wa-edit{background:var(--bg3);color:var(--tx2);border:1px solid var(--bo2);}
.wa-del{background:rgba(239,68,68,.1);color:var(--rd);border:1px solid rgba(239,68,68,.2);}
.wact:active{transform:scale(.96);}

/* WORKER GRID */
.wgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:11px 13px;}
.wfield{}.wflabel{font-size:9px;color:var(--tx2);letter-spacing:.5px;text-transform:uppercase;margin-bottom:2px;}
.wfval{font-size:12px;font-weight:600;}
.wfval.gold{color:var(--or);}

/* DOC ITEMS */
.doc-list{padding:0 13px 10px;}
.doc-title{font-size:9px;color:var(--tx2);letter-spacing:1px;text-transform:uppercase;padding:8px 0 6px;}
.doc-item{display:flex;align-items:center;justify-content:space-between;background:var(--bg3);border-radius:8px;padding:8px 10px;margin-bottom:5px;}
.doc-l{display:flex;align-items:center;gap:8px;}
.doc-ic{font-size:15px;}
.doc-dn{font-size:12px;font-weight:600;}
.doc-de{font-size:10px;color:var(--tx2);}

/* ALERT CARDS */
.ac{background:var(--bg2);border-left:3px solid var(--rd);border-radius:var(--r);margin:0 13px 9px;padding:12px 14px;display:flex;gap:10px;}
.ac.warn{border-left-color:var(--or);}
.ac.debt{border-left-color:var(--cy);}
.ac-ico{font-size:19px;flex-shrink:0;}
.ac-title{font-size:13px;font-weight:700;margin-bottom:3px;}
.ac-desc{font-size:11px;color:var(--tx2);line-height:1.6;}
.ac-fee{font-size:11px;color:var(--or);margin-top:4px;font-weight:600;}

/* FEE TABLE */
.fee-item{background:var(--bg2);border:1px solid var(--bo2);border-radius:var(--r);padding:12px 14px;margin-bottom:7px;display:flex;align-items:center;justify-content:space-between;gap:10px;}
.fi-info{flex:1;}
.fi-name{font-size:13px;font-weight:600;}
.fi-desc{font-size:10px;color:var(--tx2);margin-top:3px;line-height:1.5;}
.fi-price{font-size:15px;font-weight:700;color:var(--or);white-space:nowrap;}

/* PERMIT CALC */
.cc{background:var(--bg2);border:1px solid var(--bo2);border-radius:var(--r);padding:14px;margin:0 13px;}
.cc-title{font-size:11px;font-weight:700;color:var(--tx2);letter-spacing:.5px;text-transform:uppercase;margin-bottom:10px;}
.cr{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--bo2);font-size:12px;}
.cr:last-of-type{border-bottom:none;}
.cr.tot{font-weight:700;font-size:14px;border-top:1px solid var(--bo);padding-top:10px;margin-top:4px;}
.cr.tot .cv{color:var(--or);}
.cv{font-weight:600;}
.ctog{display:flex;gap:6px;margin-bottom:10px;}
.ctb{flex:1;padding:8px;border-radius:9px;font-family:'Noto Sans SC',sans-serif;font-size:12px;font-weight:600;cursor:pointer;border:1px solid var(--bo2);background:var(--bg3);color:var(--tx2);transition:all .15s;}
.ctb.on{background:var(--or);color:#1a0e00;border-color:var(--or);}

/* STATS */
.sg{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 13px;}
.sc{background:var(--bg2);border:1px solid var(--bo2);border-radius:var(--r);padding:13px;}
.sc-lbl{font-size:10px;color:var(--tx2);margin-bottom:5px;}
.sc-val{font-size:20px;font-weight:800;}

/* CHAT */
.cw{padding:10px 13px 0;display:flex;flex-direction:column;gap:7px;min-height:160px;}
.msg{max-width:84%;padding:9px 12px;border-radius:15px;font-size:13px;line-height:1.5;animation:mIn .22s ease;}
@keyframes mIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.msg.bot{background:var(--bg3);border:1px solid var(--bo2);border-bottom-left-radius:4px;align-self:flex-start;}
.msg.user{background:var(--or);color:#1a0e00;font-weight:600;border-bottom-right-radius:4px;align-self:flex-end;}
.msg-t{font-size:9px;color:var(--tx2);margin-top:3px;}
.msg.user .msg-t{color:rgba(26,14,0,.5);text-align:right;}
.chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px;}
.chip{background:var(--bg2);border:1px solid var(--bo2);color:var(--tx);font-size:11px;padding:5px 10px;border-radius:20px;cursor:pointer;font-family:'Noto Sans SC',sans-serif;transition:all .12s;}
.chip:active{background:var(--or);color:#1a0e00;border-color:var(--or);}
.typing{display:inline-flex;align-items:center;gap:3px;padding:2px 0;}
.typing span{width:5px;height:5px;border-radius:50%;background:var(--tx2);animation:db 1.2s infinite;}
.typing span:nth-child(2){animation-delay:.2s;}
.typing span:nth-child(3){animation-delay:.4s;}
@keyframes db{0%,80%,100%{transform:scale(.7);opacity:.5}40%{transform:scale(1);opacity:1}}
.ibar{position:fixed;bottom:0;left:0;right:0;background:var(--bg2);border-top:1px solid var(--bo2);padding:9px 13px 13px;display:flex;gap:7px;align-items:center;z-index:50;}
.ibar input{flex:1;background:var(--bg3);border:1px solid var(--bo2);border-radius:22px;padding:9px 14px;color:var(--tx);font-family:'Noto Sans SC',sans-serif;font-size:13px;outline:none;}
.ibar input:focus{border-color:var(--or);}
.send{width:38px;height:38px;border-radius:50%;background:var(--or);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;}
.send:active{transform:scale(.9);}

/* MODAL */
.mo{position:fixed;inset:0;background:rgba(0,0,0,.65);backdrop-filter:blur(4px);z-index:200;display:flex;align-items:flex-end;opacity:0;pointer-events:none;transition:opacity .25s;}
.mo.open{opacity:1;pointer-events:all;}
.mb{background:var(--bg2);border:1px solid var(--bo2);border-radius:20px 20px 0 0;width:100%;max-height:92vh;overflow-y:auto;transform:translateY(100%);transition:transform .32s cubic-bezier(.32,.72,0,1);padding-bottom:36px;}
.mo.open .mb{transform:translateY(0);}
.mh{width:36px;height:4px;background:rgba(255,255,255,.12);border-radius:2px;margin:12px auto 14px;}
.mt{font-size:16px;font-weight:700;padding:0 18px 12px;}
.mbody{padding:0 18px;display:flex;flex-direction:column;gap:10px;}
.mbtns{display:flex;gap:8px;margin-top:4px;}
.mbtn{flex:1;padding:12px;border-radius:11px;cursor:pointer;font-family:'Noto Sans SC',sans-serif;font-size:13px;font-weight:600;border:1px solid var(--bo2);background:var(--bg3);color:var(--tx2);}
.mbtn.pri{background:var(--or);color:#1a0e00;border-color:var(--or);}
.mbtn:active{transform:scale(.97);}
.add-row{display:flex;align-items:center;justify-content:center;gap:8px;margin:8px 13px;padding:12px;background:rgba(245,166,35,.06);border:1px dashed var(--bo);border-radius:var(--r);cursor:pointer;color:var(--or);font-size:12px;font-weight:600;}

::-webkit-scrollbar{width:2px;}
::-webkit-scrollbar-thumb{background:rgba(245,166,35,.25);border-radius:2px;}
</style>
</head>
<body>

<div class="hdr">
  <div class="hdr-l">
    <div class="hdr-ico">🏢</div>
    <div>
      <span class="hdr-name">HR Home</span>
      <span class="hdr-sub">外劳人力资源</span>
    </div>
  </div>
  <div id="hpill" class="hdr-pill" onclick="goTab(2)">⚠️ 0</div>
</div>

<div class="tabs">
  <button class="tab on"  onclick="goTab(0)">记账</button>
  <button class="tab"     onclick="goTab(1)">👷 外劳</button>
  <button class="tab"     onclick="goTab(2)">⚠️ 提醒</button>
  <button class="tab"     onclick="goTab(3)">💰 收费</button>
  <button class="tab"     onclick="goTab(4)">📊 统计</button>
</div>

<div class="area" id="area">

  <!-- PAGE 0: 记账 -->
  <div class="pg on" id="pg0">
    <div class="cw" id="cw"></div>
  </div>

  <!-- PAGE 1: 外劳档案 -->
  <div class="pg" id="pg1">
    <div class="sbar">
      <span style="font-size:14px;color:var(--tx2)">🔍</span>
      <input id="ws" placeholder="搜索外劳姓名..." oninput="renderW()">
    </div>
    <div class="ftabs">
      <button class="ftab on" onclick="wf('all',this)">全部</button>
      <button class="ftab" onclick="wf('debt',this)">💸 有欠款</button>
      <button class="ftab" onclick="wf('exp',this)">⚠️ 文件过期</button>
      <button class="ftab" onclick="wf('warn',this)">⏰ 将到期</button>
    </div>
    <div id="wCards"></div>
    <div class="add-row" onclick="openWForm(null)">➕ 添加新外劳</div>
    <div style="height:10px"></div>
  </div>

  <!-- PAGE 2: 提醒 -->
  <div class="pg" id="pg2">
    <div class="sh"><span class="st">需要处理的事项</span></div>
    <div id="alertList"></div>
    <div style="height:20px"></div>
  </div>

  <!-- PAGE 3: 收费表 -->
  <div class="pg" id="pg3">
    <div class="sh"><span class="st">特别项目收费</span></div>
    <div style="padding:0 13px">
      <div class="fee-item"><div class="fi-info"><div class="fi-name">逾期前3天</div><div class="fi-desc">ESP 处理费</div></div><div class="fi-price">RM 150</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">逾期第1–90天</div><div class="fi-desc">ESP RM50/天</div></div><div class="fi-price">RM 50/天</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">逾期超过90天</div><div class="fi-desc">ESP 固定费用</div></div><div class="fi-price">RM 3,100 + 1,500</div></div>
    </div>
    <div class="sh"><span class="st">FOMEMA</span></div>
    <div style="padding:0 13px">
      <div class="fee-item"><div class="fi-info"><div class="fi-name">单一（血/X-Ray）自找协助</div></div><div class="fi-price">RM 750</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">单一 公司找协助</div></div><div class="fi-price">RM 1,000</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">全套 自找协助</div></div><div class="fi-price">RM 1,500</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">全套 公司找协助</div></div><div class="fi-price">RM 2,000</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">FOMEMA 漂白</div></div><div class="fi-price">RM 3,500</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">FOMEMA 外来</div></div><div class="fi-price">RM 2,700</div></div>
    </div>
    <div class="sh"><span class="st">其他项目</span></div>
    <div style="padding:0 13px">
      <div class="fee-item"><div class="fi-info"><div class="fi-name">部门相关文件</div></div><div class="fi-price">RM 100</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">亲属相关文件</div></div><div class="fi-price">RM 300</div></div>
      <div class="fee-item"><div class="fi-info"><div class="fi-name">更新家属证</div></div><div class="fi-price">RM 350</div></div>
