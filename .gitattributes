function now12(){ const d=new Date(); return `${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}`; }
function today(){ return new Date().toISOString().slice(0,10); }
function daysUntil(e){ if(!e) return null; return Math.round((new Date(e)-new Date())/864e5); }
function docSt(e){
  if(!e) return 'none';
  const d=daysUntil(e);
  if(d<0) return 'exp';
  if(d<120) return 'warn';
  return 'ok';
}
function wSt(w){
  if(w.status==='inactive') return 'inactive';
  const ss=w.docs.map(d=>docSt(d.expiry));
  if(ss.includes('exp')) return 'exp';
  if(ss.includes('warn')) return 'warn';
  return 'ok';
}
function invTotals(w){
  let billed=0,paid=0;
  (w.invoices||[]).forEach(inv=>{
    billed+=inv.amount;
    (inv.payments||[]).forEach(p=>{ paid+=p.amount; });
  });
  return {billed, paid, balance: billed-paid};
}
function fmt(n){ return 'RM '+n.toFixed(2); }

